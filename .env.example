# Copia este archivo como «.env» solo si quieres cargar las claves a mano.
# Lo más fácil es pegar la clave en el panel: se guarda sola aquí, en tu computadora.
# Este archivo nunca se sube ni se comparte.

# Tu clave de ElevenLabs (solo si eliges voz de ElevenLabs)
ELEVENLABS_API_KEY=
# La voz que elegiste en el panel
ELEVENLABS_VOZ_ID=

# Modelo de whisper.cpp para sincronizar tu grabación: base (más liviano) o small (más preciso)
WHISPER_MODELO=base
